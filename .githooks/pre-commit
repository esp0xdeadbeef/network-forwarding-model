#!/usr/bin/env bash
# Pre-commit: parse-check staged Nix files.
#
# This repository's committed Nix style is the leading-comma form; it is NOT
# nixfmt-rfc-style. Running nixfmt here rewrote whole files on every commit and
# mixed formatting churn into unrelated semantic changes. The hook therefore
# only verifies that each staged file parses, and never rewrites the author's
# formatting.
set -euo pipefail

mapfile -t changed < <(git diff --cached --name-only --diff-filter=ACMR | grep '\.nix$' || true)
[ ${#changed[@]} -eq 0 ] && exit 0

echo "[hook] parsing staged nix files..."

for f in "${changed[@]}"; do
    [ -f "$f" ] || continue
    nix-instantiate --parse "$f" >/dev/null
done

echo "[hook] done"
